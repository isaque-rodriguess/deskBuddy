{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deskbuddy",
  "version": "0.1.0",
  "identifier": "com.deskbuddy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Desktop Pet",
        "width": 680,
        "height": 480,
        "minWidth": 500,
        "minHeight": 350,
        "decorations": true,
        "visible": false,
        "url": "index.html"
      },
      {
        "label": "overlay",
        "title": "Pet Overlay",
        "width": 192,
        "height": 208,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/*", "$APPDATA/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/zero-2/spritesheet.webp", "resources/zero-2/pet.json"]
  }
}
